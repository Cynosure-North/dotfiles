{
    // --- Extensions ---
    "shellcheck.logLevel": "error",
    // Todo Tree
    "todo-tree.regex.regex": "((//|#|<!--|;|/\\*|^|^[ \\t]*(-|\\d+.))\\s*|\\\\)($TAGS)",
    "todo-tree.general.tags": [
        "TODO",
        "todo!",
        "todo{",
        "BUG",
        "HACK",
        "FIXME",
        "[ ]",
        "[x]",
        "NOTE"
    ],
    "todo-tree.general.tagGroups": {
        "TODO": [
            "todo!",
            "todo{"
        ]
    },
    // Nvim
    "vscode-neovim.neovimExecutablePaths.linux": "/usr/bin/nvim",
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    // Gitlens
    "gitlens.views.scm.grouped.views": {
        "commits": false,
        "branches": false,
        "remotes": false,
        "stashes": false,
        "tags": false,
        "worktrees": false,
        "contributors": false,
        "repositories": false,
        "searchAndCompare": false,
        "launchpad": false
    },
    "gitlens.advanced.abbreviateShaOnCopy": true,
    "gitlens.showWhatsNewAfterUpgrades": false,
    "gitlens.plusFeatures.enabled": false,
    "gitlens.hovers.avatars": false,
    "gitlens.codeLens.authors.enabled": false,
    "gitlens.codeLens.enabled": false,
    // Copilot
    "chat.commandCenter.enabled": false,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "latex": false,
    },
    // Cspell
    "cSpell.userWords": [
        "allistic",
        "microcontrollers"
    ],
    "cSpell.language": "en,en-AU",
    // --- Languages ---
    "[rust]": {
        "editor.formatOnSave": false // Rustfmt sucks
    },
    "rust-analyzer.lens.enable": false,
    "rust-analyzer.initializeStopped": true,
    "[latex]": {
        "editor.formatOnPaste": false,
        "editor.wordWrap": "on",
        "editor.formatOnSave": false,
        "editor.wordBasedSuggestions": "off",
        "editor.occurrencesHighlight": "off",
        "editor.snippetSuggestions": "none",
    },
    "latex-workshop.formatting.latex": "latexindent",
    "latex-utilities.message.error.show": false,
    "latex-workshop.message.error.show": false,
    "latex-utilities.message.update.show": false,
    "files.exclude": {
        "**/.vscode": true
    },
    "python.terminal.activateEnvironment": false,
    "html.autoClosingTags": false,
    // --- General ---
    // Explorer
    "explorer.excludeGitIgnore": true,
    "explorer.confirmPasteNative": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    // Editor
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.minimap.enabled": false,
    "editor.minimap.autohide": "mouseover",
    "editor.minimap.renderCharacters": false,
    "editor.renderWhitespace": "all",
    "editor.cursorSurroundingLines": 10,
    "editor.cursorSurroundingLinesStyle": "all",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.suggest.selectionMode": "whenQuickSuggestion",
    "editor.insertSpaces": false,
    "editor.rulers": [
        100
    ],
    // Terminal
    "terminal.integrated.scrollback": 2000,
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "terminal.integrated.cursorStyle": "line",
    // Git
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": true,
    // Zen
    "zenMode.centerLayout": false,
    "zenMode.hideLineNumbers": false,
    "zenMode.showTabs": "none",
    // Misc
    "window.autoDetectColorScheme": true,
    "window.customTitleBarVisibility": "windowed",
    "window.titleBarStyle": "custom",
    "workbench.layoutControl.enabled": false,
    "workbench.editor.empty.hint": "hidden",
    "workbench.navigationControl.enabled": false,
    "workbench.startupEditor": "none",
    "security.workspace.trust.untrustedFiles": "open",
    "files.autoSave": "afterDelay",
}